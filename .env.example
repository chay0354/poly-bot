# Copy to .env and edit. .env is gitignored.

# paper = simulate against live order books (no money). live = real orders.
PM_MODE=paper

# --- Live trading credentials (only needed when PM_MODE=live) ---
# Private key of the wallet that holds USDC.e on Polygon. NEVER commit this.
PM_PRIVATE_KEY=
# Signature type: 0 = EOA (key trades directly),
#                 1 = Polymarket email/magic proxy,
#                 2 = browser (Gnosis Safe) proxy.
PM_SIGNATURE_TYPE=0
# Proxy/funder address (the Polymarket deposit address) for sig types 1/2.
PM_FUNDER_ADDRESS=

# --- Sizing / risk ---
PM_STAKE_USDC=5
PM_MAX_PRICE=0.85
PM_MAX_TRADES_PER_WINDOW=1
# Simulated paper bankroll (USDC). Bot stops when it can't fund a trade.
# 0 = unlimited (no bankroll stop). Paper mode only.
PM_PAPER_BANKROLL=100
# Optional extra cap: stop after this much cumulative loss. 0 = disabled.
PM_DAILY_LOSS_LIMIT=0

# --- Momentum strategy ---
PM_MOMENTUM=true
PM_DECIDE_WITHIN=45
PM_STOP_ENTRY=3
PM_MIN_DELTA_USD=8

# --- Arbitrage strategy ---
PM_ARB=true
PM_ARB_MIN_EDGE=0.02
PM_ARB_STAKE_USDC=5

# --- Engine ---
PM_POLL_INTERVAL=1
PM_LOG_LEVEL=INFO
# Live, in-place status line (price, countdown, quotes, position, PnL).
# Auto-disables when output isn't an interactive terminal (e.g. piped to a file).
PM_LIVE_STATUS=true
# Append trade + window records (JSONL) for later study. data/ is gitignored.
PM_RECORD=true
PM_DATA_FILE=data/trades.jsonl
# Record per-second BTC price + up/down asks over the last N seconds of each
# window (the decision zone) into the window record, for backtesting. 0 = off.
PM_PATH_SECS=120
