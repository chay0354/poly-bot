# Copy to .env and edit. .env is gitignored.

# signal = tell you what to click in the browser (no wallet).
# paper  = simulate against live order books (no money).
# live   = real orders (needs PM_PRIVATE_KEY).
PM_MODE=signal

# --- Live trading credentials (only needed when PM_MODE=live) ---
# Private key of the wallet that holds USDC.e on Polygon. NEVER commit this.
PM_PRIVATE_KEY=
# Signature type: 0 = EOA (key trades directly),
#                 1 = Polymarket email/magic proxy,
#                 2 = browser (Gnosis Safe) proxy,
#                 3 = deposit / email wallet (current Polymarket accounts).
PM_SIGNATURE_TYPE=0
# Proxy/funder address (the Polymarket deposit address) for sig types 1/2.
PM_FUNDER_ADDRESS=

# --- Sizing / risk ---
PM_STAKE_USDC=5
PM_MAX_PRICE=0.85
# Don't buy a favored side offered below this: a cheap ask in the closing
# seconds means the order book already thinks that side is losing.
PM_MIN_PRICE=0.50
PM_MAX_TRADES_PER_WINDOW=1
# Simulated paper bankroll (USDC). Bot stops when it can't fund a trade.
# 0 = unlimited (no bankroll stop). Paper mode only.
PM_PAPER_BANKROLL=100
# Stop trading for the rest of the UTC day once today's estimated P&L is this
# far negative. Works in live mode (pairs lock $1, exits are realized, a held
# leg settles on the Chainlink outcome) and is persisted to
# data/day_pnl_{live|paper}.json so a restart cannot reset it. 0 = disabled.
PM_DAILY_LOSS_LIMIT=0

# --- Momentum strategy ---
PM_MOMENTUM=true
PM_DECIDE_WITHIN=45
PM_STOP_ENTRY=3
PM_MIN_DELTA_USD=25
# The market settles on the Chainlink TWAP over the final N seconds (not the
# last tick). Momentum projects that TWAP and also requires BTC would need to
# *average* at least PM_MIN_FLIP_USD away from here for the rest of the window
# to flip the result.
PM_TWAP_SECS=60
PM_MIN_FLIP_USD=20

# --- Maker-pair strategy (a trade in every window) ---
# Rest post-only bids on BOTH Up and Down early in the window (0% maker fee,
# rebates). Both hit -> $1 payout locked at a discount. One hit -> cheap
# directional leg, hedged in the closing seconds if the TWAP projection is
# against it (buy the other side up to PM_MAKER_HEDGE_MAX; 0 = never hedge).
PM_MAKER=false
PM_MAKER_BID=0.46
PM_MAKER_STAKE_USDC=5
# A side already offered at/below our bid (0.45/0.56 at T+3s) is rested one
# tick under its ask instead of skipped, down to BID − GIVE (0.44).
PM_MAKER_BID_GIVE=0.02
# Binance BTCUSDT trade stream as an early warning for the defensive cancel:
# the makers hitting our bids price off it and it leads Chainlink by seconds.
# Settlement/open stay on Chainlink. false = Chainlink only.
PM_FAST_FEED=true
# Coinbase BTC-USD as a second leading venue. Whichever venue printed most
# recently answers (deltas are always same-venue); from a US-East server its
# ticks arrive well before Binance's (Tokyo). Binance returns HTTP 451 from
# US IPs (Railway US-East) and is then stood down; Coinbase carries the tape.
# false = Binance only.
PM_COINBASE_FEED=true
# Fair-value quoting. p_up = Φ(Binance Δ since open / σ of the move still
# possible), σ from the realized 5-min range. Each bid rests at fair − EDGE
# (0.50 fair → 0.46), is pulled once fair − bid < PULL_EDGE (a fill there is
# adverse by construction), re-quoted when the target drifts ≥ REQUOTE off the
# bid, and stays within BID ± SKEW_MAX so the pair costs ≤ 1 − 2·EDGE. A side
# whose target falls under the band is unquotable; with nothing filled we then
# quote neither (never a lone leg). Falls back to the USD line below until σ
# is known (~2.5 min after start). false = fixed bid + USD line only.
PM_MAKER_FAIR=true
PM_MAKER_EDGE=0.04
PM_MAKER_PULL_EDGE=0.02
PM_MAKER_REQUOTE=0.02
PM_MAKER_SKEW_MAX=0.06
# After a risk pull, wait this long before resting a fresh pair (the loop now
# reacts to every print; without this a flickering fair pulls/re-posts 2×/s).
PM_MAKER_REPOST_SECS=2
# Rest right at the open, while the book is still ~0.50/0.50 and BTC ≈ open.
PM_MAKER_START=3
PM_MAKER_CANCEL_LEFT=75
PM_MAKER_HEDGE_MAX=0.60
# One leg filled: wait for the leftover 0.46 maker bid. Taker-complete only
# after that bid is gone, and only when fill+ask+fee <= the cap. Caps default
# to 1.00 (a real lock). Prefer sell-to-exit over paying 1.04–1.12.
PM_MAKER_PAIR_GRACE=5
PM_MAKER_PAIR_MAX_SUM=1.00
PM_MAKER_PAIR_HARD=20
PM_MAKER_PAIR_HARD_SUM=1.00
# Cancel the unfilled bid on the side BTC just moved against (dump incoming).
# 0 = off. Same Chainlink open the market settles on. USD is a floor; the
# real line is max(USD, Z × realized 5-min move × sqrt(time left/300)), so a
# $25 wiggle on a $300/window tape is noise, not a reason to sit out.
PM_MAKER_DEFENSIVE_USD=20
PM_MAKER_DEFENSIVE_Z=0.15
# Still naked after EXIT_SECS and the pair cannot close: get out (cheaper of
# selling at the bid / buying the other side) instead of holding $stake to
# resolution. 0 = never. STOP: exit at once when our side's bid is this far
# under the fill — the market decided; waiting only worsens the bid.
PM_MAKER_EXIT_SECS=30
PM_MAKER_STOP=0.04
PM_MAKER_EXIT_MIN_BID=0.10
# The exit sell is a fill-and-kill that may walk this far under the best bid.
# A thin top level used to block the whole sale and the leg was carried to a
# $0 resolution (two −$5 windows on 10 Sep).
PM_MAKER_EXIT_SLIP=0.03

# --- Fees ---
# Polymarket crypto taker fee (shares × rate × p × (1-p)); makers pay 0.
# Applied to paper fills so paper P&L is honest.
PM_TAKER_FEE_RATE=0.07

# --- Arbitrage strategy ---
PM_ARB=false
PM_ARB_MIN_EDGE=0.02
PM_ARB_STAKE_USDC=5

# --- Engine ---
# CLOB WebSockets: order books (public) and our own order events (auth, live
# mode). Each stream falls back to HTTP when down.
PM_WS_MARKET=true
PM_WS_USER=true
# The loop is event-driven: a Binance/Coinbase print, a book change, an order
# event or a finished CLOB call wakes it at once. PM_FAST_POLL is only the
# idle timeout while both books come off the socket; PM_POLL_INTERVAL when a
# book has to be fetched over HTTP. PM_MIN_TICK coalesces a burst of events
# into one iteration.
PM_FAST_POLL=0.25
PM_POLL_INTERVAL=1
PM_MIN_TICK=0.02
# Live: place/cancel run on worker threads so the loop never blocks on a CLOB
# round trip, and the next window's likely bids are signed ahead of time
# (PM_PRESIGN) so a post is a bare HTTP send.
PM_PRESIGN=true
# Live: cancel all our open orders when the bot starts (a copy killed with
# bids resting must not leave them on the book).
PM_CANCEL_ON_START=true
PM_LOG_LEVEL=INFO
# Live, in-place status line (price, countdown, quotes, position, PnL).
# Auto-disables when output isn't an interactive terminal (e.g. piped to a file).
# Auto-disables when stdout isn't a TTY (Railway, Docker, piped logs).
PM_LIVE_STATUS=false
# Append trade + window records (JSONL) for later study. data/ is gitignored.
PM_RECORD=true
PM_DATA_FILE=data/trades.jsonl
# Record per-second BTC price + up/down asks over the last N seconds of each
# window (the decision zone) into the window record, for backtesting. 0 = off.
PM_PATH_SECS=120

# Optional: log each traded window's P&L to Supabase (secret key, backend only).
# Only records from 2026-09-09 16:40 Israel time onward.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
